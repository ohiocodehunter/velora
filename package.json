{
  "name": "velora",
  "version": "1.0.0",
  "private": true,
  "description": "VELORA — Discover More. Shop Smarter. Multi-vendor MERN marketplace.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:destroy": "npm run seed:destroy --workspace server",
    "smoke": "npm run smoke --workspace server",
    "typecheck": "npm run typecheck --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "mongodb-memory-server@10.4.3": true
  }
}
