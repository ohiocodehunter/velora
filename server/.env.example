# ---------------------------------------------------------------------------
# VELORA server configuration — copy to server/.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://localhost:4173
PUBLIC_URL=http://localhost:4000

# MongoDB ------------------------------------------------------------------
# Paste your MongoDB Atlas connection string here. When this is empty the
# server starts an embedded MongoDB with a persistent .data/mongo folder.
MONGODB_URI=

# Auth ---------------------------------------------------------------------
# Use a long random string in production (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=velora_token
COOKIE_SECURE=false

# Seed / demo admin --------------------------------------------------------
ADMIN_EMAIL=admin@velora.shop
ADMIN_PASSWORD=Admin@12345
SEED_PASSWORD=Velora@123

# Cloudinary (optional) ----------------------------------------------------
# Leave empty to store uploads on local disk (server/uploads, served at /uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional) ------------------------------------------------------
# Leave empty to use the documented test flow: HMAC-signed and verified locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP / Nodemailer (optional) --------------------------------------------
# Leave empty to print emails to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VELORA <no-reply@velora.shop>

# Commerce rules -----------------------------------------------------------
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=79
TAX_RATE=0.05
